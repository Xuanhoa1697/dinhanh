<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rebate_settlement_view_form_purchase" model="ir.ui.view">
        <field name="name">rebate.settlement.form.purchase</field>
        <field name="model">rebate.settlement</field>
        <field name="inherit_id" ref="rebate_base.rebate_settlement_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tax_amount']" position="after">
                <field name="vendor_received_amount" invisible="direction != 'purchase'"/>
                <field name="vendor_pending" invisible="1"/>
            </xpath>
            <xpath expr="//sheet/div[hasclass('oe_title')]" position="before">
                <div class="alert alert-info" role="alert" invisible="not vendor_pending">
                    Chưa nhận đủ chứng từ chiết khấu của nhà cung cấp. Khi nhận hóa đơn điều chỉnh của NCC, hãy mở bản
                    nháp đã sinh (hoặc gắn quyết toán này vào hóa đơn NCC), kiểm tra số liệu rồi ghi sổ.
                </div>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Phân bổ giá vốn" name="purchase_cogs" invisible="direction != 'purchase'">
                    <field name="cogs_preview_html" invisible="purchase_alloc_ids"/>
                    <field name="purchase_alloc_ids" readonly="1" invisible="not purchase_alloc_ids">
                        <list decoration-muted="state == 'cancel'">
                            <field name="source_move_id"/>
                            <field name="product_id"/>
                            <field name="cost_method"/>
                            <field name="valuation"/>
                            <field name="stock_move_id" optional="hide"/>
                            <field name="qty_in"/>
                            <field name="qty_remaining"/>
                            <field name="amount" sum="Tổng"/>
                            <field name="to_inventory" sum="Tổng"/>
                            <field name="to_cogs" sum="Tổng"/>
                            <field name="inventory_account_id" optional="show"/>
                            <field name="cogs_account_id" optional="show"/>
                            <field name="entry_id" optional="show"/>
                            <field name="state" widget="badge"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </page>
                <page string="Khiếu nại NCC" name="claims" invisible="not claim_ids">
                    <field name="claim_ids">
                        <list editable="bottom">
                            <field name="partner_id" readonly="1"/>
                            <field name="source_move_id" readonly="1"/>
                            <field name="expected_amount" readonly="1"/>
                            <field name="received_amount" readonly="1"/>
                            <field name="difference" readonly="1"/>
                            <field name="state"/>
                            <field name="note"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="rebate_settlement_view_search_purchase" model="ir.ui.view">
        <field name="name">rebate.settlement.search.purchase</field>
        <field name="model">rebate.settlement</field>
        <field name="inherit_id" ref="rebate_base.rebate_settlement_view_search"/>
        <field name="arch" type="xml">
            <filter name="done" position="after">
                <filter name="vendor_pending" string="Chờ chứng từ NCC" domain="[('vendor_pending', '=', True)]"/>
            </filter>
        </field>
    </record>

    <record id="view_move_form_rebate_purchase" model="ir.ui.view">
        <field name="name">account.move.form.rebate.purchase</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="rebate_base.view_move_form_rebate"/>
        <field name="arch" type="xml">
            <field name="rebate_settlement_id" position="attributes">
                <attribute name="invisible">not rebate_settlement_id and move_type != 'in_refund'</attribute>
                <attribute name="readonly">state != 'draft' or move_type not in ('in_refund', 'in_invoice')</attribute>
                <attribute name="domain">[('direction', '=', 'purchase'), ('state', '=', 'done'), ('company_id', '=', company_id)]</attribute>
                <attribute name="groups">rebate_base.group_rebate_user,account.group_account_invoice</attribute>
            </field>
        </field>
    </record>

    <record id="rebate_claim_view_list" model="ir.ui.view">
        <field name="name">rebate.claim.list</field>
        <field name="model">rebate.claim</field>
        <field name="arch" type="xml">
            <list create="0" decoration-danger="state == 'open'" decoration-muted="state in ('cancel', 'written_off')">
                <field name="name"/>
                <field name="agreement_id"/>
                <field name="partner_id"/>
                <field name="source_move_id"/>
                <field name="expected_amount" sum="Tổng"/>
                <field name="received_amount" sum="Tổng"/>
                <field name="difference" sum="Tổng"/>
                <field name="state" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="rebate_claim_view_form" model="ir.ui.view">
        <field name="name">rebate.claim.form</field>
        <field name="model">rebate.claim</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_resolve" type="object" string="Đã giải quyết" class="btn-primary" invisible="state != 'open'"/>
                    <button name="action_write_off" type="object" string="Chấp nhận mất" invisible="state != 'open'"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,resolved"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="settlement_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="source_move_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="expected_amount" readonly="1"/>
                            <field name="received_amount" readonly="1"/>
                            <field name="difference" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Nội dung trao đổi với NCC…"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_rebate_claim" model="ir.actions.act_window">
        <field name="name">Khiếu nại NCC</field>
        <field name="res_model">rebate.claim</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>

    <record id="rebate_claim_view_search" model="ir.ui.view">
        <field name="name">rebate.claim.search</field>
        <field name="model">rebate.claim</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="settlement_id"/>
                <filter name="open" string="Đang khiếu nại" domain="[('state', '=', 'open')]"/>
            </search>
        </field>
    </record>

    <menuitem id="menu_rebate_claim" name="Khiếu nại NCC" parent="rebate_base.menu_rebate_settle"
              action="action_rebate_claim" sequence="30"/>
</odoo>
