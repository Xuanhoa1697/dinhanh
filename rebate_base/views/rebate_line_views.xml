<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rebate_line_view_list" model="ir.ui.view">
        <field name="name">rebate.line.list</field>
        <field name="model">rebate.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" decoration-danger="is_refund">
                <field name="date"/>
                <field name="agreement_id"/>
                <field name="period_id"/>
                <field name="rule_id"/>
                <field name="move_id"/>
                <field name="target_move_id" optional="hide"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="quantity" sum="Tổng"/>
                <field name="weight" optional="hide" sum="Tổng"/>
                <field name="amount" sum="Tổng"/>
                <field name="amount_gross" optional="hide" sum="Tổng"/>
                <field name="tax_rate" optional="show"/>
                <field name="is_refund" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="rebate_line_view_pivot" model="ir.ui.view">
        <field name="name">rebate.line.pivot</field>
        <field name="model">rebate.line</field>
        <field name="arch" type="xml">
            <pivot string="Lũy kế chiết khấu">
                <field name="partner_id" type="row"/>
                <field name="period_id" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="rebate_line_view_graph" model="ir.ui.view">
        <field name="name">rebate.line.graph</field>
        <field name="model">rebate.line</field>
        <field name="arch" type="xml">
            <graph string="Lũy kế chiết khấu" type="bar">
                <field name="period_id"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="rebate_line_view_search" model="ir.ui.view">
        <field name="name">rebate.line.search</field>
        <field name="model">rebate.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="agreement_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="move_id"/>
                <field name="period_id"/>
                <filter name="refund" string="Trả hàng / giảm" domain="[('is_refund', '=', True)]"/>
                <separator/>
                <filter name="sale" string="Bán hàng" domain="[('direction', '=', 'sale')]"/>
                <filter name="purchase" string="Mua hàng" domain="[('direction', '=', 'purchase')]"/>
                <group>
                    <filter name="group_agreement" string="Thỏa thuận" context="{'group_by': 'agreement_id'}"/>
                    <filter name="group_period" string="Kỳ" context="{'group_by': 'period_id'}"/>
                    <filter name="group_partner" string="Đối tác" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_product" string="Sản phẩm" context="{'group_by': 'product_id'}"/>
                    <filter name="group_categ" string="Nhóm sản phẩm" context="{'group_by': 'product_categ_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rebate_line" model="ir.actions.act_window">
        <field name="name">Dòng lũy kế</field>
        <field name="res_model">rebate.line</field>
        <field name="view_mode">list,pivot,graph</field>
    </record>
</odoo>
