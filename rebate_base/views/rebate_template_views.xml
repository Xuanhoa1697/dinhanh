<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rebate_template_view_list" model="ir.ui.view">
        <field name="name">rebate.template.list</field>
        <field name="model">rebate.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="direction"/>
                <field name="nature"/>
                <field name="period_type"/>
                <field name="settlement_doc"/>
                <field name="payment_method"/>
            </list>
        </field>
    </record>

    <record id="rebate_template_view_form" model="ir.ui.view">
        <field name="name">rebate.template.form</field>
        <field name="model">rebate.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="VD: CK quý cho nhà phân phối"/></h1></div>
                    <group>
                        <group string="Chung">
                            <field name="direction"/>
                            <field name="nature"/>
                            <field name="period_type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Quy tắc mặc định">
                            <field name="basis"/>
                            <field name="tier_mode"/>
                            <field name="value_type"/>
                        </group>
                        <group string="Quyết toán">
                            <field name="settlement_doc"/>
                            <field name="payment_method"/>
                            <field name="allocation_key"/>
                            <field name="cogs_split" invisible="direction != 'purchase'"/>
                        </group>
                        <group string="Xử lý ngoại lệ">
                            <field name="return_period_rule"/>
                            <field name="post_close_recalc"/>
                            <field name="negative_true_up"/>
                            <field name="mid_period_change"/>
                            <field name="stacking"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Ghi chú…"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rebate_template" model="ir.actions.act_window">
        <field name="name">Mẫu thỏa thuận</field>
        <field name="res_model">rebate.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
