<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rebate_period_view_list" model="ir.ui.view">
        <field name="name">rebate.period.list</field>
        <field name="model">rebate.period</field>
        <field name="arch" type="xml">
            <list create="0" decoration-warning="needs_recalc" decoration-muted="state == 'settled'">
                <field name="agreement_id"/>
                <field name="name"/>
                <field name="parent_id" optional="show"/>
                <field name="direction" optional="show"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="state" widget="badge" decoration-success="state == 'settled'" decoration-info="state == 'locked'"/>
                <field name="needs_recalc"/>
                <field name="settled_amount" sum="Tổng"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="rebate_period_view_form" model="ir.ui.view">
        <field name="name">rebate.period.form</field>
        <field name="model">rebate.period</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_lock" type="object" string="Khóa kỳ" invisible="state != 'open'"/>
                    <button name="action_compute_settlement" type="object" string="Tính quyết toán" class="btn-primary"
                            invisible="state == 'settled'"/>
                    <button name="action_recalc" type="object" string="Tính lại (lập chênh lệch)" class="btn-primary"
                            invisible="state != 'settled' or not needs_recalc"/>
                    <button name="action_unlock" type="object" string="Mở lại kỳ" invisible="state != 'locked'"
                            groups="rebate_base.group_rebate_admin"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_lines" type="object" class="oe_stat_button" icon="fa-list" string="Dòng lũy kế"/>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not needs_recalc">
                        Có phát sinh mới sau khi kỳ đã khóa / quyết toán. Hãy tính lại.
                    </div>
                    <div class="oe_title"><h1><field name="display_name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="agreement_id" readonly="1"/>
                            <field name="parent_id" readonly="1" invisible="not parent_id"/>
                            <field name="date_from" readonly="1"/>
                            <field name="date_to" readonly="1"/>
                            <field name="needs_recalc" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Tiến độ">
                            <field name="progress_measure"/>
                            <field name="progress_gap"/>
                            <field name="progress_amount"/>
                            <field name="settled_amount"/>
                        </group>
                    </group>
                    <field name="progress_html" nolabel="1"/>
                    <notebook>
                        <page string="Kỳ con" invisible="not child_ids">
                            <field name="child_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="state" widget="badge"/>
                                    <field name="settled_amount"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Quyết toán">
                            <field name="settlement_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="is_adjustment"/>
                                    <field name="amount"/>
                                    <field name="prior_paid"/>
                                    <field name="amount_to_settle"/>
                                    <field name="state" widget="badge"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="rebate_period_view_search" model="ir.ui.view">
        <field name="name">rebate.period.search</field>
        <field name="model">rebate.period</field>
        <field name="arch" type="xml">
            <search>
                <field name="agreement_id"/>
                <field name="name"/>
                <filter name="due" string="Đến hạn quyết toán"
                        domain="[('state', '!=', 'settled'), ('date_to', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="needs_recalc" string="Cần tính lại" domain="[('needs_recalc', '=', True)]"/>
                <filter name="open" string="Đang mở" domain="[('state', '=', 'open')]"/>
                <separator/>
                <filter name="sale" string="Bán hàng" domain="[('direction', '=', 'sale')]"/>
                <filter name="purchase" string="Mua hàng" domain="[('direction', '=', 'purchase')]"/>
                <group>
                    <filter name="group_agreement" string="Thỏa thuận" context="{'group_by': 'agreement_id'}"/>
                    <filter name="group_state" string="Trạng thái" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rebate_period" model="ir.actions.act_window">
        <field name="name">Kỳ chiết khấu</field>
        <field name="res_model">rebate.period</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_due': 1}</field>
    </record>
</odoo>
