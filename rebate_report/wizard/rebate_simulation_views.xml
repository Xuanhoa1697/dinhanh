<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rebate_simulation_view_form" model="ir.ui.view">
        <field name="name">rebate.simulation.form</field>
        <field name="model">rebate.simulation</field>
        <field name="arch" type="xml">
            <form string="Mô phỏng chiết khấu">
                <group>
                    <group>
                        <field name="period_id" readonly="1"/>
                        <field name="agreement_id" invisible="1"/>
                        <field name="rule_id" options="{'no_create': True}"/>
                        <field name="extra_amount"/>
                        <field name="extra_qty"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="current_measure"/>
                        <field name="current_amount"/>
                        <field name="new_measure"/>
                        <field name="new_amount"/>
                        <field name="delta_amount" class="fw-bold"/>
                    </group>
                </group>
                <field name="result_html" nolabel="1"/>
                <footer>
                    <button string="Đóng" special="cancel" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_rebate_simulation" model="ir.actions.act_window">
        <field name="name">Mô phỏng chiết khấu</field>
        <field name="res_model">rebate.simulation</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="rebate_base.model_rebate_period"/>
        <field name="binding_view_types">form</field>
    </record>

    <record id="rebate_period_view_form_simulation" model="ir.ui.view">
        <field name="name">rebate.period.form.simulation</field>
        <field name="model">rebate.period</field>
        <field name="inherit_id" ref="rebate_base.rebate_period_view_form"/>
        <field name="arch" type="xml">
            <button name="action_lock" position="before">
                <button name="%(action_rebate_simulation)d" type="action" string="Mô phỏng"
                        invisible="state != 'open'" context="{'active_id': id}"/>
            </button>
        </field>
    </record>
</odoo>
