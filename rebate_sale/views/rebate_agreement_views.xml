<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_rebate" model="ir.ui.view">
        <field name="name">res.partner.form.rebate</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_rebate_agreements" type="object" class="oe_stat_button" icon="fa-percent"
                        groups="rebate_base.group_rebate_user" invisible="not rebate_agreement_count">
                    <field name="rebate_agreement_count" widget="statinfo" string="Thỏa thuận CK"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
